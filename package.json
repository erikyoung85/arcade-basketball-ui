{
  "name": "arcade-basketball-ui",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "gen:version": "node scripts/gen-version.mjs",
    "start": "npm run gen:version && ng serve --host 0.0.0.0 --port 4200",
    "build": "npm run gen:version && ng build",
    "build:raspberrypi": "npm run gen:version && ng build --configuration=production --base-href /arcadebasketball/",
    "release:esp32": "npm run gen:version && ng build --configuration production && node scripts/release/index.mjs",
    "package:esp32": "node scripts/release/index.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "supabase": "supabase",
    "generate:db": "supabase gen types typescript --project-id ulqlllosknuyhjasvtci --schema arcade_basketball > database.types.ts"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^21.2.15",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeng/themes": "^21.0.4",
    "@supabase/supabase-js": "^2.106.2",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.0",
    "supabase": "^2.106.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}